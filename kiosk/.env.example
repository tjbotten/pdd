# Copy to kiosk/.env. That file is gitignored. Do not commit real values.

# Required before anyone can post or remove announcements.
KIOSK_ADMIN_PASSWORD=

# Optional. Without it the traffic band stays empty and no travel times are invented.
# Create a free key at https://developer.tomtom.com/
TOMTOM_API_KEY=

# Optional overrides.
# KIOSK_DB_PATH=
# PORT=8080
# KIOSK_HOST=0.0.0.0
# KIOSK_COOKIE_SECURE=1
